{
  "$id": "review-entry.schema.json",
  "title": "Analyse Review Entry",
  "description": "Schema for a single review temp file or manifest entry produced by the Analyse skill FileAgent.",
  "type": "object",
  "required": [
    "source_file",
    "profile",
    "type",
    "import_date",
    "participants",
    "mode",
    "reviewed_at",
    "status",
    "reconciled_at",
    "routed_to",
    "confidence",
    "extractions",
    "orphans",
    "anonymizations_applied",
    "transcript"
  ],
  "additionalProperties": false,
  "properties": {
    "source_file": {
      "type": "string",
      "pattern": "^_sources/",
      "description": "Relative path from mccullonas-kb root, e.g. _sources/GoogleDrive/filename.txt"
    },
    "profile": {
      "type": "string",
      "enum": ["product", "marketing", "finance"]
    },
    "type": {
      "type": "string",
      "enum": ["meeting", "document", "web_scrape"],
      "description": "Content origin type"
    },
    "import_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date file entered the KB (YYYY-MM-DD)"
    },
    "participants": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string"
      },
      "description": "Meeting participants (empty [] for documents)"
    },
    "mode": {
      "type": "string",
      "enum": ["full", "light", "conversation", "transcription"]
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 datetime with timezone"
    },
    "status": {
      "type": "string",
      "enum": ["active", "parked", "written_up", "pending_reconcile", "reconciled"]
    },
    "reconciled_at": {
      "type": ["string", "null"],
      "description": "ISO-8601 datetime or null if not yet reconciled"
    },
    "routed_to": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "McCullonas/Projects/Health",
          "McCullonas/Projects/HomeAutomation",
          "McCullonas/Projects/HomeLab",
          "McCullonas/Projects/Infrastructure",
          "McCullonas/Projects/Marvin",
          "McCullonas/Projects/AnnaFinance",
          "McCullonas/Projects/FitnessTracking",
          "McCullonas/Projects/NutritionTracking",
          "McCullonas/Projects/PantryTracking",
          "McCullonas/Projects/TelegramInterface",
          "LaserCutting/Product",
          "GUIDashboard/Business",
          "FollowerCounter/Business"
        ]
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "extractions": {
      "type": "object",
      "required": [
        "overview",
        "status",
        "target_users",
        "value_proposition",
        "differentiators",
        "features",
        "limitations",
        "dependencies",
        "commercial_model",
        "use_cases",
        "clients",
        "references"
      ],
      "additionalProperties": false,
      "properties": {
        "overview": { "$ref": "#/definitions/extraction_section" },
        "status": { "$ref": "#/definitions/extraction_section" },
        "target_users": { "$ref": "#/definitions/extraction_section" },
        "value_proposition": { "$ref": "#/definitions/extraction_section" },
        "differentiators": { "$ref": "#/definitions/extraction_section" },
        "features": { "$ref": "#/definitions/extraction_section" },
        "limitations": { "$ref": "#/definitions/extraction_section" },
        "dependencies": { "$ref": "#/definitions/extraction_section" },
        "commercial_model": { "$ref": "#/definitions/extraction_section" },
        "use_cases": { "$ref": "#/definitions/extraction_section" },
        "clients": { "$ref": "#/definitions/extraction_section_clients" },
        "references": { "$ref": "#/definitions/extraction_section" }
      }
    },
    "orphans": {
      "type": "array",
      "items": { "$ref": "#/definitions/orphan_entry" }
    },
    "anonymizations_applied": {
      "type": "array",
      "items": { "$ref": "#/definitions/anonymization_entry" }
    },
    "transcript": {
      "type": "string",
      "minLength": 100,
      "description": "Summary of all review rounds. Min 200 chars for full mode, 100 for light."
    }
  },
  "definitions": {
    "extraction_section": {
      "type": "object",
      "required": ["agent", "content", "confidence"],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "enum": ["Finn", "Vera", "Pippa"]
        },
        "content": {
          "type": "string",
          "description": "Flat string content. Markdown formatting OK. Never nested objects or arrays."
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      }
    },
    "extraction_section_clients": {
      "type": "object",
      "required": ["agent", "content", "confidence", "anonymized"],
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "enum": ["Finn", "Vera", "Pippa"]
        },
        "content": {
          "type": "string"
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "anonymized": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "orphan_entry": {
      "type": "object",
      "required": ["topic", "description", "suggested_action", "notes"],
      "additionalProperties": false,
      "properties": {
        "topic": { "type": "string" },
        "description": { "type": "string" },
        "suggested_action": {
          "type": "string",
          "enum": ["create_product", "expand_existing", "needs_investigation"]
        },
        "notes": { "type": "string" }
      }
    },
    "anonymization_entry": {
      "type": "object",
      "required": ["original", "replacement", "type"],
      "additionalProperties": false,
      "properties": {
        "original": { "type": "string" },
        "replacement": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["client", "financial", "pricing", "individual"]
        }
      }
    }
  }
}
