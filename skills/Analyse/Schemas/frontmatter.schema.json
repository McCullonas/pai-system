{
  "$id": "frontmatter.schema.json",
  "title": "Analyse Source File Frontmatter",
  "description": "Schema for the YAML frontmatter written into source files after review. Validates the reviews.{profile} nested structure. Shared by Analyse (document/web_scrape/meeting transcription) and ProductManager (meeting conversation).",
  "type": "object",
  "required": ["reviews"],
  "properties": {
    "reviews": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/profile_review"
      }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "profile_review": {
      "type": "object",
      "required": [
        "type",
        "import_date",
        "participants",
        "reviewed_at",
        "status",
        "mode",
        "reconciled_at",
        "confidence",
        "routed_to",
        "has_orphans"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["meeting", "document", "web_scrape"],
          "description": "Content origin type"
        },
        "import_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date file entered the KB (YYYY-MM-DD)"
        },
        "participants": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string"
          },
          "description": "Meeting participants (empty [] for documents)"
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "description": "ISO-8601 datetime with timezone, or null if not yet reviewed"
        },
        "status": {
          "type": "string",
          "enum": ["active", "parked", "written_up", "pending_reconcile", "reconciled"]
        },
        "mode": {
          "type": "string",
          "enum": ["full", "light", "conversation", "transcription"]
        },
        "reconciled_at": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "routed_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "McCullonas/Projects/Health",
              "McCullonas/Projects/HomeAutomation",
              "McCullonas/Projects/HomeLab",
              "McCullonas/Projects/Infrastructure",
              "McCullonas/Projects/Marvin",
              "McCullonas/Projects/AnnaFinance",
              "McCullonas/Projects/FitnessTracking",
              "McCullonas/Projects/NutritionTracking",
              "McCullonas/Projects/PantryTracking",
              "McCullonas/Projects/TelegramInterface",
              "LaserCutting/Product",
              "GUIDashboard/Business",
              "FollowerCounter/Business"
            ]
          }
        },
        "has_orphans": {
          "type": "boolean"
        }
      }
    }
  }
}
