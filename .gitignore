# ─── Personal config (symlinked from marvin at runtime) ─────────
settings.json
.claude/
skills/PAI/USER/
plans/

# ─── Secrets (symlinked from ~/.config/pai at runtime) ──────────
.credentials.json
.env
.env.local
.env.*.local

# ─── Memory (all content is symlinks at runtime) ────────────────
MEMORY/

# ─── Session and runtime state ──────────────────────────────────
cache/
debug/
file-history/
history.jsonl
session-env/
shell-snapshots/
todos/
tasks/
projects/
chrome/
custom-agents/
.claude.json
paste-cache/
stats-cache.json
telemetry/

# ─── Plugin state ───────────────────────────────────────────────
plugins/

# ─── Dependencies ───────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── MCP servers (large, installed fresh) ───────────────────────
mcp-servers/

# ─── Observability app (large, installed fresh) ─────────────────
Observability/

# ─── Sensitive data patterns ────────────────────────────────────
*.sensitive.txt

# ─── OS files ───────────────────────────────────────────────────
.DS_Store

# ─── Hook debug logs ────────────────────────────────────────────
hooks/*.log

# ─── Statsig analytics (Claude Code creates this) ──────────────
[Ss]tatsig/

# ─── Bun build cache and debris ─────────────────────────────────
*.bun-build
/package.json
/package-lock.json
/bun.lock

# ─── System state caches ────────────────────────────────────────
*.cache
*.log

# ─── Migration backups ──────────────────────────────────────────
skills/PAI/USER-backup-*/
